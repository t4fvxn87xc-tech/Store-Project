#include<stdio.h>
#include<string.h>
#include<stdlib.h>

#define MAX_USERS 100
#define USERNAME_LEN 30
#define PASSWORD_LEN 30

typedef struct {
    char username[USERNAME_LEN];
    char password[PASSWORD_LEN];
} User;

static User users[MAX_USERS];
static int userCount = 0;

// load users from file
int loadUsers(const char *filename) {
    FILE *file = fopen(filename, "r");
    if (file == NULL) {
        return 0; // file doesn't exist yet
    }

    while (!feof(file) && userCount < MAX_USERS) {
        fscanf(file, "%29s %29s", users[userCount].username, users[userCount].password);
        userCount++;
    }

    fclose(file);
    return 1;
}

// save users to file
void saveUsers(const char *filename) {
    FILE *file = fopen(filename, "w");
    if (file == NULL) {
        printf("Error: could not open file for saving.\n");
        return;
    }

     for (int i = 0; i < userCount; i++) {
        fprintf(file, "%s %s\n", users[i].username, users[i].password);
    }

    fclose(file);
}

// find user by username
int findUser(const char *username) {
    for (int i = 0; i < userCount; i++) {
        if (strcmp(users[i].username, username) == 0) {
            return i;
        }
    }
    return -1;
}

// register a new user
int registerUser(const char *username, const char *password) {
    if (strlen(username) == 0 || strlen(password) == 0) {
        printf("Username and password cannot be empty.\n");
        return 0;
    }

    if (findUser(username) != -1) {
        printf("User already exists.\n");
        return 0;
    }

    if (userCount >= MAX_USERS) {
        printf("Maximum users reached.\n");
        return 0;
    }

    strcpy(users[userCount].username, username);
    strcpy(users[userCount].password, password);
    userCount++;

    printf("Registration successful.\n");
    return 1;
}

// login check
int loginUser(const char *username, const char *password) {
    int index = findUser(username);

    if (index == -1) {
        printf("User not found.\n");
        return 0;
    }

    if (strcmp(users[index].password, password) == 0) {
        printf("Login successful! Welcome %s.\n", users[index].username);
        return 1;
    }

    printf("Incorrect password.\n");
    return 0;
}

int main() {
    const char *filename = "users.txt";

    loadUsers(filename);

    int choice;
    char username[USERNAME_LEN];
    char password[PASSWORD_LEN];

    while (1) {
        printf("\n=== AUTH MENU ===\n");
        printf("1. Register\n");
        printf("2. Login\n");
        printf("3. Exit\n");
        printf("Choose an option: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                printf("Enter username: ");
                scanf("%s", username);
                printf("Enter password: ");
                scanf("%s", password);

                registerUser(username, password);
                saveUsers(filename);
                break;

            case 2:
                printf("Enter username: ");
                scanf("%s", username);
                printf("Enter password: ");
                scanf("%s", password);

                loginUser(username, password);
                break;

            case 3:
                printf("Goodbye!\n");
                return 0;

            default:
                printf("Invalid choice.\n");
        }
    }

    return 0;
}